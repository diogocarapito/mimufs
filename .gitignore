# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Briefcase / packaging output
build/
dist/
logs/

# Bundled Java runtime (built per OS/arch by packaging/jre/build_jre.sh)
src/mimufs/_runtime/

# Synthetic test fixtures (regenerated by tests/fixtures/make_fixtures.py)
tests/fixtures/generated/

# Never commit project data. Patient data must never enter the repo
# (see scripts/check_no_data_files.py for the enforced allow-list).
*.mimufs
*.mimufs.wal
raw/
exports/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Briefcase local state
.briefcase/
# Written by `briefcase dev` (app metadata for importlib.metadata in dev mode)
src/*.dist-info/
